{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: starts a second VS Code window with the extension loaded, opened on the example app.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension", "${workspaceFolder}/examples/layered_app"],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
